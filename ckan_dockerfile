FROM ckan/ckan-base:2.11

USER root

ENV APP_DIR=/srv/app
ENV PATH="${APP_DIR}/bin:$PATH"


RUN apt-get update && apt-get install -y \
    nano \
    curl \
    python3-dev \
    libpq-dev \
    python3-pip \
    python3-venv \
    build-essential \
    libldap2-dev \
    libsasl2-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/
	
	
# Crear carpetas
RUN mkdir -p /srv/app/src


#Crear el Entorno Virtuaal
ENV CKAN_HOME=srv/app/src 
RUN python3 -m venv /srv/app/


WORKDIR /srv/app/src

# 1. Asegurar rutas relativas exactas en minúsculas y sin espacios
COPY ./alcala-ckan/config/ckan.ini  /srv/app/ckan.ini
COPY ./alcala-ckan/config/requeriments.txt  /srv/app/src/config/requeriments.txt
COPY ./alcala-ckan/config/ckanpluginmigrate.py /srv/app/src/config/ckanpluginmigrate.py

# 2. Copiar despliegue y extensiones federadas
COPY ./alcala-ckan/deployment  /srv/app/src/deployment
COPY ./alcala-ckan/extensions   /srv/app/src/extensions

COPY ./extensions   /srv/app/extensions

RUN /srv/app/bin/pip install --upgrade pip uwsgi wheel setuptools==65.5.1 Werkzeug==2.2.3 Flask==2.3.3 

RUN pip install -r /srv/app/src/config/requeriments.txt --no-deps --force-reinstall

RUN sed -i 's/\r$//' /srv/app/src/config/ckanpluginmigrate.py
RUN chmod +x /srv/app/src/config/ckanpluginmigrate.py

WORKDIR /srv/app

# Crear el grupo ckan y añadir el usuario existente a él
RUN groupadd -r ckan && usermod -aG ckan ckan

# IMPORTANTE: Permisos para las carpetas donde CKAN escribe (subidas de archivos)
RUN mkdir -p /var/lib/ckan/storage /var/lib/ckan/webassets && \
    chown -R ckan:ckan /var/lib/ckan
	
RUN chown -R ckan:ckan /srv/app/src /srv/app/ckan.ini		

# Cambiar al usuario ckan
USER ckan

EXPOSE 5000

CMD ["/srv/app/bin/uwsgi", "--ini", "/srv/app/src/proyecto-ckan/deployment/ckan-uwsgi.ini"]
