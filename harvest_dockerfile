FROM ckan/ckan-base:2.11

USER root

ENV APP_DIR=/srv/app
ENV PATH="${APP_DIR}/bin:$PATH"


RUN apt-get update && apt-get install -y \
    nano \
    curl \
    python3-dev \
    libpq-dev \
    python3-pip \
    python3-venv \
    build-essential \
    libldap2-dev \
    libsasl2-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/
	
	
# Crear carpetas
RUN mkdir -p /srv/app/src


#Crear el Entorno Virtuaal
ENV CKAN_HOME=srv/app/src 
RUN python3 -m venv /srv/app/


WORKDIR /srv/app/src

# 1. Asegurar rutas relativas exactas en minúsculas y sin espacios
COPY ./harvest/config/ckan.ini  /srv/app/ckan.ini
COPY ./harvest/config/ckan.ini  /srv/app/src/ckan/ckan.ini
COPY ./harvest/config/harvest_requeriments.txt  /srv/app/src/config/harvest_requeriments.txt


# 2. Copiar despliegue y extensiones federadas
COPY ./harvest/deployment  /srv/app/src/deployment
COPY ./harvest/extensions   /srv/app/src/extensions

COPY ./extensions   /srv/app/extensions

RUN /srv/app/bin/pip install --upgrade pip

RUN pip install uwsgi wheel "rq>=1.14.0,<2.0.0" "setuptools>=44.1.0,<82" Werkzeug==2.3.7 Flask==2.3.3 

RUN pip install -r /srv/app/src/ckan/requirements.txt
RUN pip install -e /srv/app/src/ckan

RUN pip install -r /srv/app/src/config/harvest_requeriments.txt

WORKDIR /srv/app

# Crear el grupo ckan y añadir el usuario existente a él
RUN groupadd -r ckan && usermod -aG ckan ckan

# IMPORTANTE: Permisos para las carpetas donde CKAN escribe (subidas de archivos)
RUN mkdir -p /var/lib/ckan/storage /var/lib/ckan/webassets && \
    chown -R ckan:ckan /var/lib/ckan
	
RUN chown -R ckan:ckan /srv/app/src /srv/app/ckan.ini		

# Cambiar al usuario ckan
USER ckan

EXPOSE 5000

CMD ["/srv/app/bin/uwsgi", "--ini", "/srv/app/src/deployment/ckan-uwsgi.ini"]
